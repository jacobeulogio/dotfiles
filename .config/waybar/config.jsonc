[
    {
        "position": "top",
        "height": 32,
        "output": "DP-2",
        "modules-left": [
            "custom/disk_icon",
            "disk",
            "custom/memory_icon",
            "memory",
            "custom/cpu_icon",
            "cpu",
            "temperature"
        ],
        "modules-center": [
            "hyprland/workspaces"
        ],
        "modules-right": [
            "backlight",
            "backlight/slider",
            "pulseaudio",
            "pulseaudio/slider",
            "network",
            "tray",
            "battery",
            "clock"
        ],
        "include": [
